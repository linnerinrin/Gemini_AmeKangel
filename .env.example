# 复制为 .env 后按实际情况修改。.env 已在 .gitignore 中，不会被提交。
# 下面标注"必填"的项若缺失，应用启动时会直接报错。

# ── 本地模型路径（必填，相对仓库根或绝对路径）──
BI_ENCODER_PATH=models/all-MiniLM-L6-v2
CROSS_ENCODER_PATH=models/ms-marco-MiniLM-L-6-v2

# ── 数据库（必填，库名默认 gemini，启动时自动建表）──
MYSQL_USER=root
MYSQL_PASSWORD=
# MYSQL_DATABASE=gemini

# ── 初始场景与记忆（必填）──
# 0=糖糖私聊 1=超天酱直播 2=堕天酱直播 3=糖糖直播
INITIAL_MODE=0
SHORT_MEMORY_LEN=10

# ── RAG 检索（必填）──
RAG_RECALL_SIZE=5
RAG_RERANK_SIZE=3
# RAG_DEVICE=cpu          # 默认 cuda，没有 N 卡时改成 cpu

# ── 推理参数（可选；max_tokens 为 0 表示不限制，交给模型自行决定）──
# INFERENCE_MAX_TOKENS=0
# INFERENCE_TEMPERATURE=0.8
# INFERENCE_TOP_P=0.9

# ── 服务（可选，默认 0.0.0.0:5577）──
# HOST=0.0.0.0
# PORT=5577
# DEBUG=false

# ── 模型接口（可选）──
# 优先使用控制面板保存的设置（data/llm_settings.json）；这里只是回退来源。
# 两者都没配时，界面会提示「尚未配置 API Key」。
# DEEPSEEK_MODEL=deepseek-v4-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
